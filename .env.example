# Twilio credentials (from console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio phone number (e.g. +15551234567)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Public URL of this server (needed so Twilio can reach your webhooks)
# For local dev use ngrok: https://abc123.ngrok.io
# For production: https://haroldhotline.yourdomain.com
BASE_URL=https://your-server-url.com

# Port to run the server on
PORT=3000

# Harold's Instagram handle (optional, mentioned in confession thank-you)
HAROLD_INSTAGRAM=@haroldthecat

# Directory where audio files are stored (defaults to public/audio/ for local dev)
# On Railway with a volume mounted at /data, set this to /data/audio
AUDIO_DIR=

# Audio file URLs — point these at your hosted audio files.
# You can serve them from this server by placing .mp3 files in public/audio/
# and using ${BASE_URL}/audio/filename.mp3, or use any publicly accessible URL.
# If left empty, the hotline uses silent pauses of the appropriate length.
HOLD_MUSIC_URL=
HAROLD_MEOWING_SHORT_URL=
HAROLD_MEOWING_LONG_URL=
